package main

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net"
	"os"
	"strings"
)

// Config structure matches the config.json in your install.sh
type Config struct {
	Listen          string   `json:"listen"`
	StreamBuffer    int      `json:"stream_buffer"`
	ReceiveBuffer   int      `json:"receive_buffer"`
	Auth            AuthConfig `json:"auth"`
	Forward         string   `json:"forward"` // optional
}

type AuthConfig struct {
	Mode      string   `json:"mode"`
	Passwords []string `json:"passwords"`
}

var config Config

func loadConfig(path string) error {
	data, err := os.ReadFile(path)
	if err != nil {
		return err
	}
	return json.Unmarshal(data, &config)
}

func isAuthenticated(password string) bool {
	hash := sha256.Sum256([]byte(password))
	hashStr := hex.EncodeToString(hash[:])
	for _, p := range config.Auth.Passwords {
		if hex.EncodeToString(sha256.New().Sum([]byte(p))) == hashStr {
			return true
		}
	}
	return false
}

func main() {
	if len(os.Args) < 3 || os.Args[1] != "server" {
		log.Fatal("Usage: udp-custom server -c config.json")
	}
	configPath := ""
	for i, arg := range os.Args {
		if arg == "-c" && i+1 < len(os.Args) {
			configPath = os.Args[i+1]
			break
		}
	}
	if configPath == "" {
		log.Fatal("Missing config file")
	}

	if err := loadConfig(configPath); err != nil {
		log.Fatalf("Failed to load config: %v", err)
	}

	if config.Forward == "" {
		config.Forward = "127.0.0.1:22" // default SSH forward
	}

	udpAddr, err := net.ResolveUDPAddr("udp", config.Listen)
	if err != nil {
		log.Fatal(err)
	}

	conn, err := net.ListenUDP("udp", udpAddr)
	if err != nil {
		log.Fatal(err)
	}
	defer conn.Close()
	log.Printf("UDP Custom listening on %s, forwarding to %s", config.Listen, config.Forward)

	buf := make([]byte, 1500)
	for {
		n, clientAddr, err := conn.ReadFromUDP(buf)
		if err != nil {
			log.Println("Read error:", err)
			continue
		}

		// Extract password from first packet (plain text)
		password := strings.TrimSpace(string(buf[:n]))
		if !isAuthenticated(password) {
			conn.WriteToUDP([]byte("auth_failed"), clientAddr)
			continue
		}

		// Create local connection to target
		targetConn, err := net.Dial("tcp", config.Forward)
		if err != nil {
			log.Println("Target connect error:", err)
			conn.WriteToUDP([]byte("target_unreachable"), clientAddr)
			continue
		}

		// Create a dedicated UDP connection back to the client
		clientConn, err := net.DialUDP("udp", nil, clientAddr)
		if err != nil {
			targetConn.Close()
			continue
		}

		// Send success
		clientConn.Write([]byte("ok"))

		// Bidirectional copy
		go func() {
			io.Copy(targetConn, clientConn)
			targetConn.Close()
		}()
		go func() {
			io.Copy(clientConn, targetConn)
			clientConn.Close()
		}()
	}
}
